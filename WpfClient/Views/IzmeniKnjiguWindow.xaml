<Window x:Class="WpfClient.Views.IzmeniKnjiguWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmeni knjigu"
        Height="450" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ISBN *" Margin="0,0,0,2"/>
            <TextBox x:Name="txtIsbn" Margin="0,0,0,8" TextChanged="ValidateForm"/>

            <TextBlock Text="Naziv *" Margin="0,0,0,2"/>
            <TextBox x:Name="txtNaziv" Margin="0,0,0,8" TextChanged="ValidateForm"/>

            <TextBlock Text="Cena *" Margin="0,0,0,2"/>
            <TextBox x:Name="txtCena" Margin="0,0,0,8" TextChanged="ValidateForm"/>

            <TextBlock Text="Godina izdanja *" Margin="0,0,0,2"/>
            <TextBox x:Name="txtGodinaIzdanja" Margin="0,0,0,8" TextChanged="ValidateForm"/>

            <TextBlock Text="Zanr *" Margin="0,0,0,2"/>
            <TextBox x:Name="txtZanr" Margin="0,0,0,8" TextChanged="ValidateForm"/>

            <TextBlock Text="Autor *" Margin="0,0,0,2"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtAutor" Grid.Column="0" IsReadOnly="True" Background="#F4F4F4" Margin="0,0,6,0"/>
                <Button x:Name="btnDodajAutora" Grid.Column="1" Content="+" Width="28" Height="24" Margin="0,0,4,0" Click="BtnDodajAutora_Click"/>
                <Button x:Name="btnUkloniAutora" Grid.Column="2" Content="-" Width="28" Height="24" Click="BtnUkloniAutora_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odustani" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True" Click="BtnOdustani_Click"/>
            <Button x:Name="btnPotvrdi" Content="Potvrdi" Width="90" Height="30" IsEnabled="False" Click="BtnPotvrdi_Click"/>
        </StackPanel>
    </Grid>
</Window>