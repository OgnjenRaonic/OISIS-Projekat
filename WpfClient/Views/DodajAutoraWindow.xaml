<Window x:Class="WpfClient.Views.DodajAutoraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodavanje autora"
        Height="520" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Ime *" Margin="0,0,0,2"/>
                <TextBox x:Name="txtIme" Margin="0,0,0,8" TextChanged="ValidateForm"/>

                <TextBlock Text="Prezime *" Margin="0,0,0,2"/>
                <TextBox x:Name="txtPrezime" Margin="0,0,0,8" TextChanged="ValidateForm"/>

                <TextBlock Text="Datum rođenja *" Margin="0,0,0,2"/>
                <DatePicker x:Name="dpDatumRodjenja" Margin="0,0,0,8" SelectedDateChanged="DpDatumRodjenja_SelectedDateChanged"/>

                <TextBlock Text="Broj lične karte *" Margin="0,0,0,2"/>
                <TextBox x:Name="txtBrojLicneKarte" Margin="0,0,0,8" TextChanged="ValidateForm"/>

                <TextBlock Text="Godine iskustva *" Margin="0,0,0,2"/>
                <TextBox x:Name="txtGodineIskustva" Margin="0,0,0,8" TextChanged="ValidateForm"/>

                <TextBlock Text="Telefon" Margin="0,0,0,2"/>
                <TextBox x:Name="txtTelefon" Margin="0,0,0,8"/>

                <TextBlock Text="E-mejl *" Margin="0,0,0,2"/>
                <TextBox x:Name="txtEmail" Margin="0,0,0,10" TextChanged="ValidateForm"/>

                <TextBlock Text="Adresa" FontWeight="SemiBold" Margin="0,4,0,6"/>

                <TextBlock Text="Ulica" Margin="0,0,0,2"/>
                <TextBox x:Name="txtUlica" Margin="0,0,0,8"/>

                <TextBlock Text="Broj" Margin="0,0,0,2"/>
                <TextBox x:Name="txtBroj" Margin="0,0,0,8"/>

                <TextBlock Text="Grad" Margin="0,0,0,2"/>
                <TextBox x:Name="txtGrad" Margin="0,0,0,8"/>

                <TextBlock Text="Država" Margin="0,0,0,2"/>
                <TextBox x:Name="txtDrzava" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odustani" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True" Click="BtnOdustani_Click"/>
            <Button x:Name="btnPotvrdi" Content="Potvrdi" Width="90" Height="30" IsEnabled="False" Click="BtnPotvrdi_Click"/>
        </StackPanel>
    </Grid>
</Window>