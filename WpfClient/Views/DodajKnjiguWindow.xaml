<Window x:Class="WpfClient.Views.DodajKnjiguWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodavanje knjige"
        Height="430" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<TextBlock Text="ISBN *" Margin="0,0,0,2"/>
			<TextBox x:Name="txtIsbn" Margin="0,0,0,8" TextChanged="ValidateForm"/>

			<TextBlock Text="Naziv *" Margin="0,0,0,2"/>
			<TextBox x:Name="txtNaziv" Margin="0,0,0,8" TextChanged="ValidateForm"/>

			<TextBlock Text="Zanr *" Margin="0,0,0,2"/>
			<TextBox x:Name="txtZanr" Margin="0,0,0,8" TextChanged="ValidateForm"/>

			<TextBlock Text="Godina izdanja *" Margin="0,0,0,2"/>
			<TextBox x:Name="txtGodinaIzdanja" Margin="0,0,0,8" TextChanged="ValidateForm"/>

			<TextBlock Text="Cena *" Margin="0,0,0,2"/>
			<TextBox x:Name="txtCena" Margin="0,0,0,8" TextChanged="ValidateForm"/>

			<TextBlock Text="Broj strana *" Margin="0,0,0,2"/>
			<TextBox x:Name="txtBrojStrana" Margin="0,0,0,8" TextChanged="ValidateForm"/>
		</StackPanel>

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button Content="Odustani" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True" Click="BtnOdustani_Click"/>
			<Button x:Name="btnPotvrdi" Content="Potvrdi" Width="90" Height="30" IsEnabled="False" Click="BtnPotvrdi_Click"/>
		</StackPanel>
	</Grid>
</Window>