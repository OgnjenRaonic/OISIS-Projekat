<Window x:Class="WpfClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sajam knjiga"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <DockPanel LastChildFill="True">
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="menuFile" Header="_File">
                <MenuItem x:Name="menuNew" Header="_New" InputGestureText="Ctrl+N" Click="MenuNew_Click"/>
                <MenuItem x:Name="menuSave" Header="_Save" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <Separator/>
                <MenuItem x:Name="menuOpen" Header="_Open">
                    <MenuItem Header="Posetioci" Click="TabPosetioci_Click"/>
                    <MenuItem Header="Autori" Click="TabAutori_Click"/>
                    <MenuItem Header="Knjige" Click="TabKnjige_Click"/>
                    <MenuItem x:Name="menuIzdavaci" Header="Izdavači" Click="MenuIzdavaci_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="menuClose" Header="_Close" InputGestureText="Ctrl+C" Click="MenuClose_Click"/>
            </MenuItem>

            <MenuItem x:Name="menuEdit" Header="_Edit">
                <MenuItem Header="_Edit" InputGestureText="Ctrl+E" Click="MenuEdit_Click"/>
                <MenuItem x:Name="menuDelete" Header="_Delete" InputGestureText="Ctrl+Del" Click="MenuDelete_Click"/>
            </MenuItem>

            <MenuItem x:Name="menuHelp" Header="_Help">
                <MenuItem x:Name="menuAbout" Header="_About" Click="MenuAbout_Click"/>
            </MenuItem>

            <MenuItem x:Name="menuLanguage" Header="_Jezik">
                <MenuItem x:Name="menuLangSr" Header="Srpski" IsCheckable="True" IsChecked="True" Click="MenuLangSr_Click"/>
                <MenuItem x:Name="menuLangEn" Header="Engleski" IsCheckable="True" IsChecked="False" Click="MenuLangEn_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="btnAdd" ToolTip="Dodaj novi entitet (Ctrl+N)" Click="ToolbarAdd_Click">
                    <TextBlock Text="+" FontWeight="Bold"/>
                </Button>
                <Button x:Name="btnEdit" ToolTip="Izmeni selektovani entitet (Ctrl+E)" Click="ToolbarEdit_Click">
                    <TextBlock Text="Edit"/>
                </Button>
                <Button x:Name="btnDelete" ToolTip="Obriši selektovani entitet (Ctrl+Del)" Click="ToolbarDelete_Click">
                    <TextBlock Text="Del"/>
                </Button>
                <Separator/>
                <TextBox x:Name="txtSearch"
                         Width="200"
                         VerticalAlignment="Center"
                         ToolTip="Unesite kriterijum pretrage"
                         KeyDown="TxtSearch_KeyDown"
                         TextChanged="txtSearch_TextChanged"/>
                <Button x:Name="btnSearch" ToolTip="Pretraži" Click="ToolbarSearch_Click">
                    <TextBlock Text="Search"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtStatusApp" Text="Sajam knjiga"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtStatusTime" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtStatusDate"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Paginacija -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6">
            <Button x:Name="btnPrevPage" Content="◀ Prethodna" Padding="8,3" Margin="0,0,10,0" Click="BtnPrevPage_Click"/>
            <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center" Text="Strana 1 / 1"/>
            <Button x:Name="btnNextPage" Content="Sledeća ▶" Padding="8,3" Margin="10,0,0,0" Click="BtnNextPage_Click"/>
        </StackPanel>

        <!-- Centralni panel sa tabovima -->
        <TabControl x:Name="mainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- Tab Posetioci -->
            <TabItem x:Name="tabPosetioci" Header="Posetioci">
                <DataGrid x:Name="dgPosetioci" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Broj članske karte" Binding="{Binding BrojClanskeKarte}" Width="*"/>
                        <DataGridTextColumn Header="Ime" Binding="{Binding Ime}" Width="*"/>
                        <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime}" Width="*"/>
                        <DataGridTextColumn Header="Adresa" Binding="{Binding Adresa}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab Autori -->
            <TabItem x:Name="tabAutori" Header="Autori">
                <DataGrid x:Name="dgAutori"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Sorting="DgAutori_Sorting"
                          MouseDoubleClick="DgAutori_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ime" SortMemberPath="Ime" Binding="{Binding Ime}" Width="*"/>
                        <DataGridTextColumn Header="Prezime" SortMemberPath="Prezime" Binding="{Binding Prezime}" Width="*"/>
                        <DataGridTextColumn Header="Broj lične karte" SortMemberPath="BrojLicneKarte" Binding="{Binding BrojLicneKarte}" Width="*"/>
                        <DataGridTextColumn Header="Datum rođenja" SortMemberPath="DatumRodjenja" Binding="{Binding DatumRodjenja, StringFormat={}{0:dd.MM.yyyy.}}" Width="*"/>
                        <DataGridTextColumn Header="E-mejl" SortMemberPath="Email" Binding="{Binding Email}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab Knjige -->
            <TabItem x:Name="tabKnjige" Header="Knjige">
                <DataGrid x:Name="dgKnjige"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Sorting="DgKnjige_Sorting"
                          MouseDoubleClick="DgKnjige_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ISBN" SortMemberPath="ISBN" Binding="{Binding ISBN}" Width="*"/>
                        <DataGridTextColumn Header="Naziv" SortMemberPath="Naziv" Binding="{Binding Naziv}" Width="*"/>
                        <DataGridTextColumn Header="Cena" SortMemberPath="Cena" Binding="{Binding Cena, StringFormat={}{0:N0} RSD}" Width="*"/>
                        <DataGridTextColumn Header="Godina izdanja" SortMemberPath="GodinaIzdanja" Binding="{Binding GodinaIzdanja}" Width="*"/>
                        <DataGridTextColumn Header="Žanr" SortMemberPath="Zanr" Binding="{Binding Zanr}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>