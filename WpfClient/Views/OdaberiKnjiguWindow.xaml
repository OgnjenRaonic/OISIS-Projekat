<Window x:Class="WpfClient.Views.OdaberiKnjiguWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj knjigu"
        Height="320" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Knjige:" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <ListBox x:Name="lstKnjige" Grid.Row="1" SelectionChanged="LstKnjige_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding ISBN}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Naziv}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odustani" Width="85" Height="28" Margin="0,0,8,0" IsCancel="True" Click="BtnOdustani_Click"/>
            <Button x:Name="btnPotvrdi" Content="Potvrdi" Width="85" Height="28" IsEnabled="False" Click="BtnPotvrdi_Click"/>
        </StackPanel>
    </Grid>
</Window>